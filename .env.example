# ============================================================
# skyRopeLLM - 训练环境变量配置
# 复制此文件为 .env 后根据实际需求修改
#   cp .env.example .env
# ============================================================

# ---- 训练轮数 ----
EPOCHS=2

# ---- Batch Size ----
BATCH_SIZE=32

# ---- 学习率 ----
LR=5e-4

# ---- 梯度累积步数 ----
ACCUM_STEPS=8

# ---- MoE (1=开启, 0=dense) ----
USE_MOE=1

# ---- 冻结策略 (VLM: 0/1/2) ----
FREEZE_LLM=2

# ---- 基础权重 (VLM SFT/GRPO) ----
FROM_WEIGHT=pretrain_vlm

# ---- GPU 数量 (all / 1 / 2 / 4 / 8) ----
GPU_COUNT=all

# ---- WandB / SwanLab 项目名 ----
WANDB_PROJECT=skyRope-Training

# ---- NCCL 配置 (Infiniband 环境启用) ----
NCCL_IB_DISABLE=1
NCCL_NET_GDR_LEVEL=0

# ---- PyTorch 编译加速 ----
# USE_COMPILE=1

# ---- 自定义额外参数 ----
# EXTRA_ARGS="--use_moe 1 --hidden_size 1024 --use_compile 1"
